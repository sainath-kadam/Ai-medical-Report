# ==== Required — the app will not start without these ====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/medscan
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
SIGNED_URL_SECRET=replace-with-another-long-random-string

# ==== AI — pick a provider; leave keys blank to run in zero-cost mock mode ====
# gemini (default): Flash models by default, Gemini Pro while an organization's High-Accuracy
# Mode toggle is on (paid plan); does both image analysis and report writing.
# anthropic: Claude does both instead. mock: placeholder content, no real AI call.
AI_PROVIDER=gemini

# Required for: AI_PROVIDER=gemini. Free at https://aistudio.google.com.
GEMINI_API_KEY=
# Optional: full report TEXT drafting (generate/revise/classify_change_request/extract_intake).
# Defaults to gemini-3.6-flash.
GEMINI_MODEL=
# Optional: IMAGE interpretation only (the "look at the pixels" step). Kept independent of
# GEMINI_MODEL above so it can run a different model. Defaults to gemini-3.8-flash (Pro models need a paid Gemini plan; on the free tier they return quota errors).
GEMINI_IMAGING_MODEL=
# Optional: the pre-report clinical-summary step only (summarize_findings) — also kept
# independent of the two settings above. Defaults to gemini-3.8-flash (Pro models need a paid Gemini plan; on the free tier they return quota errors).
GEMINI_SUMMARY_MODEL=
# Optional: used INSTEAD of GEMINI_IMAGING_MODEL and GEMINI_SUMMARY_MODEL while an organization's
# High-Accuracy Mode toggle (Organization Settings) is on. Defaults to gemini-3.1-pro-preview,
# which needs a paid Gemini plan (Pro has zero free-tier quota) — on a free key a high-accuracy
# run logs a warning and falls back to the standard Flash model instead of failing. Report text
# (GEMINI_MODEL) is never escalated: it only rewrites findings that were already computed.
GEMINI_HIGH_ACCURACY_MODEL=
# Comma-separated models to fall back to, in order, when the requested Gemini model is
# overloaded (503 "high demand", 429, 5xx — after a short retry), out of free-tier quota, or
# does not exist (404). Defaults to gemini-3.6-flash,gemini-3.5-flash-lite. Free-tier daily
# quota is per model (Flash: 20 requests/day each, ~4 requests per report), so a separate
# last-resort model is what keeps reports flowing once the Flash quotas are spent for the day.
GEMINI_FALLBACK_MODELS=

# Required for: AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com.
AI_API_KEY=

# ==== Optional — only needed for specific features ====
# Required for: CORS, if the frontend isn't running on the default :5173.
CLIENT_URL=http://localhost:5173
# Production behind a reverse proxy (Render, Fly, nginx...) — see DEPLOY.md:
# ENVIRONMENT=production turns on the HSTS header and INFO-level logs. FORWARDED_ALLOW_IPS=*
# is read by uvicorn (not the app) and makes request.client.host the real user IP instead of
# the proxy's — without it the per-IP rate limiter treats every user as one client.
# ENVIRONMENT=production
# FORWARDED_ALLOW_IPS=*
# Required for: the "Sign in with Google" button (email/password login works without it).
GOOGLE_CLIENT_ID=

# Required for: switching file storage off local disk. local | cloudinary | firebase | s3 | s3_compatible.
STORAGE_PROVIDER=local
# Optional second provider — uploads land here whenever STORAGE_PROVIDER is unavailable
# (not configured, or the upload fails), and reads check both. e.g. cloudinary first,
# firebase if Cloudinary is down: STORAGE_PROVIDER=cloudinary + STORAGE_FALLBACK_PROVIDER=firebase
STORAGE_FALLBACK_PROVIDER=
# --- cloudinary ---
# Copy the "API environment variable" from Cloudinary Console > Dashboard, or set the
# three separate values below instead. Files are stored as private ("authenticated") assets.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- firebase ---
# Service-account JSON from Firebase Console > Project Settings > Service Accounts.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
# --- s3 / s3_compatible ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Required for: taking real payment once a trial expires (checkout/webhook). The trial
# itself works fine with these blank. Get these from https://dashboard.stripe.com.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
