VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Local-dev-only: set to true to browse every page without logging in (see
# src/utils/devFlags.ts). Pages still call the real API with no token, so anything that
# fetches data shows its normal empty/error state — this only stops the app from bouncing
# you to /login. Never set this to true outside your own machine.
VITE_SKIP_AUTH=false
